FMP_API_KEY=your_fmp_api_key_here
PAPER_MODE=true
INITIAL_CASH=100000
BOT_TIMEZONE=America/New_York
REQUEST_TIMEOUT_SECONDS=20
LOG_LEVEL=INFO
BOT_STORAGE_DIR=          # set to /data on Railway (attach a Volume at that path)
BOT_DATA_DIR=             # leave blank to use BOT_STORAGE_DIR/data
BOT_LOG_DIR=              # leave blank to use BOT_STORAGE_DIR/logs

MAX_POSITION_FRACTION=0.02
DAILY_HALT_DRAWDOWN=0.05
KILL_SWITCH_DRAWDOWN=0.15
TRAILING_STOP_PCT=0.0               # 0 = disabled; e.g. 0.10 → close when price drops 10% from peak
MAX_OPEN_POSITIONS=0                # 0 = unlimited; portfolio-wide cap across all strategies
COOLDOWN_CONSECUTIVE_LOSSES=0       # 0 = disabled; pause after N consecutive losing trades
COOLDOWN_PERIODS=3                  # trade cycles to skip when cooldown triggers

# Volatility targeting — scales position size so dollar-risk stays constant
# Formula: leverage = VOL_TARGET_ANNUAL / realized_vol  (clamped to [min, max])
# Enable after ~20 trading days of price history have accumulated
VOL_TARGETING_ENABLED=false
VOL_TARGET_ANNUAL=0.10
VOL_WINDOW_DAYS=20
VOL_USE_EWMA=true
VOL_EWMA_DECAY=0.94
VOL_MAX_LEVERAGE=2.0
VOL_MIN_ALLOCATION=0.20
VOL_NO_TRADE_BAND=0.10
VOL_MAX_HISTORY_DAYS=60

STOCK_MAX_PE=20
STOCK_MAX_PB=3
STOCK_MAX_DEBT_TO_EQUITY=0.5
STOCK_VIX_BUY_THRESHOLD=25
STOCK_RUN_INTERVAL_DAYS=7
STOCK_MAX_POSITIONS=3
STOCK_VIX_SYMBOL=^VIX

CRYPTO_SYMBOLS=BTCUSDT,ETHUSDT
CRYPTO_BUY_FEAR_THRESHOLD=25
CRYPTO_SELL_FEAR_THRESHOLD=75
CRYPTO_USE_COINBASE_PRICING=true

# Coinbase Advanced Trade API (https://www.coinbase.com/settings/api)
COINBASE_API_KEY=your_coinbase_api_key_here
COINBASE_API_SECRET=your_coinbase_api_secret_here

# Telegram Bot (create via @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_id

# Scheduler (for run-daemon mode)
SCHEDULER_CRYPTO_INTERVAL_MINUTES=15
SCHEDULER_STOCK_CHECK_HOUR=9
SCHEDULER_HEARTBEAT_INTERVAL_MINUTES=60
SCHEDULER_POLL_INTERVAL_SECONDS=60

# Polymarket Prediction Markets (optional)
POLYMARKET_ENABLED=false
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_PRIVATE_KEY=
POLYMARKET_MARKET_TAGS=crypto,finance
POLYMARKET_MIN_VOLUME=100000
POLYMARKET_MIN_LIQUIDITY=10000
POLYMARKET_BUY_YES_THRESHOLD=0.30
POLYMARKET_BUY_NO_THRESHOLD=0.70
POLYMARKET_TAKE_PROFIT=0.50
POLYMARKET_STOP_LOSS=0.15
POLYMARKET_MAX_POSITIONS=3
POLYMARKET_USE_TRADING_AGENTS=false
SCHEDULER_POLYMARKET_INTERVAL_MINUTES=30

# TradingAgents AI Analysis (optional)
TRADING_AGENTS_ENABLED=false
TRADING_AGENTS_LLM_PROVIDER=anthropic
TRADING_AGENTS_QUICK_MODEL=claude-haiku-4-5-20251001
TRADING_AGENTS_DEEP_MODEL=claude-sonnet-4-6
TRADING_AGENTS_CONFIRMATION_MODE=log_only
TRADING_AGENTS_CACHE_TTL_HOURS=4
TRADING_AGENTS_MAX_COST_PER_RUN=0.50
TRADING_AGENTS_MAX_COST_PER_MONTH=20.00
TRADING_AGENTS_MAX_DEBATE_ROUNDS=1
TRADING_AGENTS_TIMEOUT_SECONDS=120
ANTHROPIC_API_KEY=
# Multi-analyst personas (multiple AI perspectives, inspired by ai-hedge-fund)
# When enabled, analysts evaluate signals independently then aggregate via
# weighted voting instead of a single two-tier Haiku→Sonnet pipeline.
TRADING_AGENTS_MULTI_ANALYST=false
# Comma-separated persona keys: value_investor, growth_investor, contrarian,
# technical_analyst, sentiment_analyst, risk_analyst
TRADING_AGENTS_ANALYSTS=value_investor,contrarian,sentiment_analyst

# Prediction Markets (via Kalshi API)
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY=
PREDICTION_ENABLED=false
PREDICTION_MAX_POSITIONS=5
PREDICTION_MARKET_CATEGORIES=crypto,economics,finance,politics,weather
PREDICTION_CHECK_INTERVAL_MINUTES=15
PREDICTION_MIN_VOLUME_USD=5000
PREDICTION_MAX_SPREAD_USD=0.15
PREDICTION_CAPITAL_PCT=0.40

# Altcoin Rotation
ROTATION_CAPITAL_PCT=0.60

# Freqtrade Integration (optional)
FREQTRADE_ENABLED=false
FREQTRADE_API_SERVER_PORT=8080
