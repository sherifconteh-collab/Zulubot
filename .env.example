FMP_API_KEY=your_fmp_api_key_here
PAPER_MODE=true
INITIAL_CASH=100000
BOT_TIMEZONE=America/New_York
REQUEST_TIMEOUT_SECONDS=20
LOG_LEVEL=INFO
BOT_STORAGE_DIR=          # set to /data on Railway (attach a Volume at that path)
BOT_DATA_DIR=             # leave blank to use BOT_STORAGE_DIR/data
BOT_LOG_DIR=              # leave blank to use BOT_STORAGE_DIR/logs
TRADE_AUDIT_PATH=         # leave blank to use BOT_DATA_DIR/trade_audit.jsonl

MAX_POSITION_FRACTION=0.02
DAILY_HALT_DRAWDOWN=0.05
KILL_SWITCH_DRAWDOWN=0.15
TRAILING_STOP_PCT=0.0               # 0 = disabled; e.g. 0.10 → close when price drops 10% from peak
MAX_OPEN_POSITIONS=0                # 0 = unlimited; portfolio-wide cap across all strategies
COOLDOWN_CONSECUTIVE_LOSSES=0       # 0 = disabled; pause after N consecutive losing trades
COOLDOWN_PERIODS=3                  # trade cycles to skip when cooldown triggers

# Volatility targeting — scales position size so dollar-risk stays constant
# Formula: leverage = VOL_TARGET_ANNUAL / realized_vol  (clamped to [min, max])
# Enable after ~20 trading days of price history have accumulated
VOL_TARGETING_ENABLED=false
VOL_TARGET_ANNUAL=0.10
VOL_WINDOW_DAYS=20
VOL_USE_EWMA=true
VOL_EWMA_DECAY=0.94
VOL_MAX_LEVERAGE=2.0
VOL_MIN_ALLOCATION=0.20
VOL_NO_TRADE_BAND=0.10
VOL_MAX_HISTORY_DAYS=60

STOCK_MAX_PE=25
STOCK_MAX_PB=3.5
STOCK_MAX_DEBT_TO_EQUITY=0.75
STOCK_VIX_BUY_THRESHOLD=20
STOCK_RUN_INTERVAL_DAYS=3
STOCK_MAX_POSITIONS=5
STOCK_VIX_SYMBOL=^VIX
# Warren-Buffett-style quality filters. Set STOCK_MIN_ROE=0 to disable the
# ROE floor; set STOCK_MIN_HOLD_DAYS=0 to disable the min-hold-days guard.
STOCK_MIN_ROE=0.15
STOCK_MIN_HOLD_DAYS=14

# Online learning: the bot records realized P&L per symbol and benches
# symbols that have accumulated losses. A winning close resets the counter.
LEARNING_ENABLED=true
LEARNING_LOSER_COOLDOWN_LOSSES=3
LEARNING_LOSER_COOLDOWN_CYCLES=10

CRYPTO_SYMBOLS=BTCUSDT,ETHUSDT,XRPUSDT
CRYPTO_BUY_FEAR_THRESHOLD=35
CRYPTO_SELL_FEAR_THRESHOLD=75
CRYPTO_USE_COINBASE_PRICING=true
# If true, only buy crypto when Binance perpetual funding rate is negative.
# Default false = trade on Fear & Greed alone (more aggressive; used to be a
# hard gate that kept Coinbase crypto idle for long stretches).
CRYPTO_REQUIRE_NEGATIVE_FUNDING=false
# Autonomous per-position exits for Coinbase crypto (fire independent of Fear &
# Greed). Take-profit closes on +15% unrealized gain, stop-loss on -10% loss.
CRYPTO_TAKE_PROFIT_PCT=0.15
CRYPTO_STOP_LOSS_PCT=0.10
# Per-symbol capital weights (default: equal weight 1.0 for every symbol).
# Scales the per-trade budget for that symbol. Example overweights XRP 2x:
CRYPTO_SYMBOL_WEIGHTS=XRPUSDT:2.0,BTCUSDT:1.0,ETHUSDT:1.0
# Per-symbol exit overrides — symbols not listed fall back to the global
# CRYPTO_TAKE_PROFIT_PCT / CRYPTO_STOP_LOSS_PCT. XRP is more volatile, so it
# gets wider bands here (0.0 disables the rule for that symbol).
CRYPTO_TAKE_PROFIT_OVERRIDES=XRPUSDT:0.20
CRYPTO_STOP_LOSS_OVERRIDES=XRPUSDT:0.12
# Trend filter: skip a buy when the coin's own price is more than the
# tolerance below its N-day SMA (avoids buying a coin in a steep downtrend
# just because market-wide fear is high). Fails open without price history.
CRYPTO_TREND_FILTER_ENABLED=true
CRYPTO_TREND_SMA_DAYS=20
CRYPTO_TREND_TOLERANCE_PCT=0.05

# Coinbase Advanced Trade API (https://www.coinbase.com/settings/api)
# Coinbase is used for price data only unless this is true. All trading is on Kalshi.
COINBASE_TRADING_ENABLED=false
COINBASE_API_KEY=your_coinbase_api_key_here
COINBASE_API_SECRET=your_coinbase_api_secret_here

# Telegram Bot (create via @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_id

# Scheduler (for run-daemon mode)
SCHEDULER_CRYPTO_INTERVAL_MINUTES=10
SCHEDULER_STOCK_CHECK_HOUR=9
# Routine Telegram alerts are batched into one message every N hours (0 = send each immediately).
# Replies to commands (/status, /sports...) and a kill-switch trigger are always immediate.
TELEGRAM_DIGEST_HOURS=6
SCHEDULER_HEARTBEAT_INTERVAL_MINUTES=60
# Scheduled periodic heartbeat Telegram messages. Disabled by default — they
# were the main source of notification spam. Set to true only if you want a
# regular status ping. You can always fetch status on demand with /status.
SCHEDULER_HEARTBEAT_ENABLED=false
SCHEDULER_POLL_INTERVAL_SECONDS=45
SCHEDULER_BTC5MIN_INTERVAL_MINUTES=5  # same as BTC5MIN_INTERVAL_MINUTES

# BTC 5-min spread strategy (Kalshi + Polymarket implied price vs Coinbase spot)
BTC5MIN_ENABLED=true
BTC5MIN_INTERVAL_MINUTES=5            # alias for SCHEDULER_BTC5MIN_INTERVAL_MINUTES
BTC5MIN_SYMBOL=BTCUSDT
BTC5MIN_BUY_SPREAD_THRESHOLD=0.02   # 2% spread triggers trade
BTC5MIN_MAX_STRIKE_AGE_HOURS=48.0   # only use markets expiring within 48h
BTC5MIN_MIN_KALSHI_VOLUME_USD=3000.0
BTC5MIN_MIN_POLY_VOLUME_USD=50000.0
BTC5MIN_SPOT_TRADING_ENABLED=true   # also trade spot BTC on significant spreads

# Polymarket Prediction Markets (optional)
POLYMARKET_ENABLED=false
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_PRIVATE_KEY=
POLYMARKET_MARKET_TAGS=crypto,finance
POLYMARKET_MIN_VOLUME=50000
POLYMARKET_MIN_LIQUIDITY=5000
POLYMARKET_BUY_YES_THRESHOLD=0.35
POLYMARKET_BUY_NO_THRESHOLD=0.65
POLYMARKET_TAKE_PROFIT=0.50
POLYMARKET_STOP_LOSS=0.15
POLYMARKET_MAX_POSITIONS=5
POLYMARKET_USE_TRADING_AGENTS=false
SCHEDULER_POLYMARKET_INTERVAL_MINUTES=20
# Gate new Polymarket entries on Markov regime signal (skip when bear; default true)
POLYMARKET_MARKOV_GATE=true

# TradingAgents AI Analysis (optional)
TRADING_AGENTS_ENABLED=false
TRADING_AGENTS_LLM_PROVIDER=anthropic   # or: ollama
TRADING_AGENTS_QUICK_MODEL=claude-haiku-4-5-20251001
TRADING_AGENTS_DEEP_MODEL=claude-sonnet-4-6
# How AI verdicts affect trades:
#   boost    = scale position size (agree → 1.5x, disagree → 0.5x); quant
#              signals still decide WHEN to trade (recommended)
#   require  = AI must approve or the buy is blocked entirely
#   log_only = record the verdict but never affect trades
TRADING_AGENTS_CONFIRMATION_MODE=boost
TRADING_AGENTS_CACHE_TTL_HOURS=4
TRADING_AGENTS_MAX_COST_PER_RUN=0.50
TRADING_AGENTS_MAX_COST_PER_MONTH=25.00
TRADING_AGENTS_MAX_DEBATE_ROUNDS=1
TRADING_AGENTS_TIMEOUT_SECONDS=120
# Stop calling the AI after repeated API failures (cooldown then retry).
# On by default to protect the monthly budget; the Haiku pre-screen also
# fails closed (an error skips the expensive deep-analysis call).
TRADING_AGENTS_CIRCUIT_BREAKER_ENABLED=true
ANTHROPIC_API_KEY=
# Ollama (free local inference — alternative to Anthropic)
# Set TRADING_AGENTS_LLM_PROVIDER=ollama and point to your Ollama server:
# TRADING_AGENTS_LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=https://your-tunnel.example.com   # or http://localhost:11434
# TRADING_AGENTS_QUICK_MODEL=qwen3:8b
# TRADING_AGENTS_DEEP_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434
# HTTP retry / backoff (disabled by default)
HTTP_RETRY_ENABLED=false
HTTP_RETRY_MAX_ATTEMPTS=3
HTTP_RETRY_BASE_DELAY_SECONDS=0.50
HTTP_RETRY_MAX_DELAY_SECONDS=4.00
HTTP_RETRY_BACKOFF_MULTIPLIER=2.00
# Stale-price reporting / observability (disabled by default)
PRICE_STALENESS_ENABLED=false
PRICE_STALENESS_STOCK_MAX_AGE_SECONDS=900
PRICE_STALENESS_CRYPTO_MAX_AGE_SECONDS=180
PRICE_STALENESS_PREDICTION_MAX_AGE_SECONDS=300
PRICE_STALENESS_LATENCY_MAX_AGE_SECONDS=15
OBS_TRADE_AUDIT_ENABLED=false
OBS_MODULE_LATENCY_WINDOW=50
OBS_MAX_STALE_SYMBOLS_IN_SUMMARY=10
# Multi-analyst personas (multiple AI perspectives, inspired by ai-hedge-fund)
# When enabled, analysts evaluate signals independently then aggregate via
# weighted voting instead of a single two-tier Haiku→Sonnet pipeline.
TRADING_AGENTS_MULTI_ANALYST=false
# Comma-separated persona keys: value_investor, growth_investor, contrarian,
# technical_analyst, sentiment_analyst, risk_analyst
TRADING_AGENTS_ANALYSTS=value_investor,contrarian,sentiment_analyst
# AI safety / advanced Anthropic features (all opt-in)
TRADING_AGENTS_PROMPT_GUARD_ENABLED=false
TRADING_AGENTS_CIRCUIT_BREAKER_ENABLED=false
TRADING_AGENTS_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
TRADING_AGENTS_CIRCUIT_BREAKER_COOLDOWN_SECONDS=300
TRADING_AGENTS_STREAMING_ENABLED=false
TRADING_AGENTS_TOOL_CALLING_ENABLED=false
TRADING_AGENTS_EXTENDED_THINKING_ENABLED=false
TRADING_AGENTS_THINKING_BUDGET_TOKENS=1024
TRADING_AGENTS_THINKING_DISPLAY=omitted
TRADING_AGENTS_VISION_ENABLED=false
TRADING_AGENTS_BOOST_AGREE_MULTIPLIER=1.50
TRADING_AGENTS_BOOST_DISAGREE_MULTIPLIER=0.50
TRADING_AGENTS_BOOST_MIN_CONFIDENCE=0.60
TRADING_AGENTS_REQUIRE_MIN_CONFIDENCE=0.50
TRADING_AGENTS_ANALYST_BUY_THRESHOLD=0.20
TRADING_AGENTS_ANALYST_SELL_THRESHOLD=-0.20
TRADING_AGENTS_DEFAULT_INPUT_COST_PER_M=3.00
TRADING_AGENTS_DEFAULT_OUTPUT_COST_PER_M=15.00
TRADING_AGENTS_ESTIMATED_INPUT_TOKENS_PER_CALL=1500
TRADING_AGENTS_ESTIMATED_OUTPUT_TOKENS_PER_CALL=300
TRADING_AGENTS_MODEL_PRICING_JSON={"claude-haiku-4-5-20251001":{"input_cost_per_m":0.80,"output_cost_per_m":4.00},"claude-sonnet-4-6":{"input_cost_per_m":3.00,"output_cost_per_m":15.00}}

# Prediction Markets (via Kalshi API)
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY=
PREDICTION_ENABLED=false
PREDICTION_MAX_POSITIONS=8
PREDICTION_MARKET_CATEGORIES=crypto,economics,finance,politics,weather,sports,entertainment
PREDICTION_CHECK_INTERVAL_MINUTES=15
PREDICTION_MIN_VOLUME_USD=3000
PREDICTION_MAX_SPREAD_USD=0.20
PREDICTION_CAPITAL_PCT=0.40
PREDICTION_BUY_YES_THRESHOLD=0.45       # Buy YES when mid < threshold (wider = more aggressive)
PREDICTION_BUY_NO_THRESHOLD=0.55        # Buy NO when mid > threshold (wider = more aggressive)
# If true, crypto-category markets additionally require an extreme Fear &
# Greed reading (<=30 or >=70). Default false = trade crypto predictions on
# the price threshold alone, matching all other categories.
PREDICTION_REQUIRE_CRYPTO_FNG=false
# Gate new Kalshi entries on Markov regime signal (skip when bear; default true)
PREDICTION_MARKOV_GATE=true
# Pages of 50 markets fetched per Kalshi series (coverage breadth). The bot
# also interleaves categories round-robin so one busy category (e.g. CPI)
# can't fill every position slot, and takes at most 1 position per
# multi-outcome event (best-edge contract wins).
PREDICTION_MAX_PAGES_PER_SERIES=3
# Opt-in: also discover new Kalshi series from the events API instead of
# only the built-in series lists.
PREDICTION_DISCOVER_SERIES=false

# Altcoin Rotation
ROTATION_CAPITAL_PCT=0.60
ROTATION_SCOUT_MULTIPLIER=3.0
ROTATION_CHECK_INTERVAL_MINUTES=30
# "Never go backwards" memory expiry: remembered best coin quantities older
# than this many cycles are ignored so a coin crash can't permanently block
# re-entry. 0 = never expire (legacy behavior).
ROTATION_QTY_MEMORY_CYCLES=336

# Freqtrade Integration (optional)
FREQTRADE_ENABLED=false
FREQTRADE_API_SERVER_PORT=8080

# Kalshi Latency Arb (optional)
LATENCY_ARB_ENABLED=false
LATENCY_ARB_SYMBOLS=BTC-USD,ETH-USD
LATENCY_ARB_MOMENTUM_WINDOW=30
LATENCY_ARB_MOMENTUM_THRESHOLD=0.30
LATENCY_ARB_MIN_EDGE=0.05
LATENCY_ARB_KELLY_FRACTION=0.25
LATENCY_ARB_MAX_POSITION_PCT=0.08
LATENCY_ARB_MAX_OPEN_CONTRACTS=4
LATENCY_ARB_SCAN_INTERVAL=2.0
LATENCY_ARB_PRICE_HISTORY=120
LATENCY_ARB_TAKE_PROFIT=0.20
LATENCY_ARB_STOP_LOSS=0.15
LATENCY_ARB_MIN_TRADE_USD=1.0
LATENCY_ARB_AI_CONFIRMATION=boost
LATENCY_ARB_MAX_PRICE_AGE_SECONDS=15

# Kalshi Sports (optional) — bets on Kalshi game-winner markets using ESPN
# schedule, sportsbook odds, ESPN's matchup predictor and team records.
# Paper-trades unless PAPER_MODE=false AND Kalshi credentials are set.
KALSHI_SPORTS_ENABLED=true
# Leagues to scan (skipped automatically when Kalshi has no open markets, e.g. offseason):
#  nfl, ncaaf (FBS), ncaaf-fcs, ncaamb, ncaawb, nba, wnba, mlb, nhl,
#  soccer: epl, laliga, bundesliga, seriea, ligue1, mls, ligamx, ucl, uel, worldcup
KALSHI_SPORTS_LEAGUES=nfl,ncaaf,ncaaf-fcs,ncaamb,ncaawb,nba,wnba,mlb,nhl,epl,laliga,bundesliga,seriea,ligue1,mls,ligamx,ucl,uel
# Add Kalshi series to a league, e.g. nfl=KXNFLGAME
KALSHI_SPORTS_SERIES=
KALSHI_SPORTS_INTERVAL_MINUTES=30
KALSHI_SPORTS_MAX_HOURS_AHEAD=48
KALSHI_SPORTS_MIN_MINUTES_TO_START=5
# No fixed edge/price cutoffs: each bet is sized by net edge (after Kalshi's fee)
# relative to how uncertain the estimate is. These are risk limits and cost inputs.
KALSHI_SPORTS_KELLY_FRACTION=0.25
KALSHI_SPORTS_MAX_POSITION_PCT=0.10
KALSHI_SPORTS_CAPITAL_PCT=0.50
KALSHI_SPORTS_MAX_OPEN_BETS=10
KALSHI_SPORTS_MIN_TRADE_USD=1.0
KALSHI_SPORTS_HOME_ADVANTAGE=0.55
KALSHI_SPORTS_FEE_RATE=0.07
# Require a sportsbook line for each game (ESPN predictor/records alone are too weak)
KALSHI_SPORTS_REQUIRE_MARKET_SIGNAL=true
# Stakes scale with the current wallet (wins compound). After a bad day they shrink with
# drawdown from the day's peak, never below 25% of normal. 0 disables the scaling.
KALSHI_SPORTS_DRAWDOWN_THROTTLE=0.5
# Sports keeps running when the global kill switch / daily halt is tripped by other strategies
# (and its bets are not liquidated). It still obeys its own per-bet and exposure caps.
KALSHI_SPORTS_IGNORE_GLOBAL_HALT=true
# Add Polymarket's real-money game prices (public Gamma API) as an independent signal
KALSHI_SPORTS_USE_POLYMARKET=true
# Max legs in suggested parlays (0 = off). Suggestions only: never placed automatically.
KALSHI_SPORTS_PARLAY_MAX_LEGS=4
# Bets you place yourself from Telegram (/games, /bet, /confirm): default stake and the
# largest single bet, as a share of the wallet.
KALSHI_SPORTS_USER_BET_DEFAULT_PCT=0.05
KALSHI_SPORTS_USER_BET_MAX_PCT=0.25
# Parlays you build with /parlay: default stake and largest stake (share of the wallet), and
# how many seconds to wait for market makers to quote before giving up.
KALSHI_SPORTS_USER_PARLAY_DEFAULT_PCT=0.02
KALSHI_SPORTS_USER_PARLAY_MAX_PCT=0.05
# Most legs in a parlay you build with /parlay or /stack (same sport; 0-1 turns them off).
KALSHI_SPORTS_USER_PARLAY_MAX_LEGS=10
KALSHI_SPORTS_PARLAY_QUOTE_WAIT_SECONDS=20
KALSHI_SPORTS_HOLD_TO_SETTLEMENT=true
KALSHI_SPORTS_STOP_LOSS=0
KALSHI_SPORTS_TAKE_PROFIT=0

# Telegram Leads / Watchlist
# Push per-strategy "watching" alerts to Telegram after each cycle when the
# bot identifies a tradeable signal but does NOT execute (e.g. position size
# rounded to zero, max-positions cap, AI veto). Deduped per strategy per day.
# A /leads command shows the current cached watchlist on demand.
LEADS_NOTIFICATION_ENABLED=true
LEADS_MAX_PER_MESSAGE=10

# Markov Chain Regime Strategy
# 3-state (Bull/Bear/Sideways) regime detection using daily price history.
# Enabled by default — collects price history immediately and begins trading
# once MIN_HISTORY_DAYS of data have accumulated (~40 days). Use /markov in
# Telegram to check current regime state and signal at any time.
MARKOV_ENABLED=true
MARKOV_SYMBOLS=BTCUSDT,ETHUSDT,XRPUSDT
MARKOV_REGIME_SYMBOL=BTCUSDT          # symbol whose price history drives regime detection
MARKOV_RETURN_WINDOW=20               # rolling-return window in days for state labeling
MARKOV_BULL_THRESHOLD=0.02            # +2% rolling return → Bull state
MARKOV_BEAR_THRESHOLD=-0.02           # -2% rolling return → Bear state
MARKOV_ENTRY_SIGNAL_THRESHOLD=0.10    # buy when bull_prob - bear_prob > this
MARKOV_EXIT_SIGNAL_THRESHOLD=0.00     # close when signal drops below this
MARKOV_STOP_LOSS_PCT=0.10             # 10% stop-loss per position
MARKOV_TAKE_PROFIT_PCT=0.20           # 20% take-profit per position
MARKOV_MIN_HISTORY_DAYS=40            # minimum days before strategy trades
MARKOV_LAPLACE_ALPHA=0.1              # Laplace smoothing (prevents zero-prob transitions)
MARKOV_FORECAST_STEPS=1               # Chapman-Kolmogorov steps ahead (1 = next period)
MARKOV_RUN_INTERVAL_MINUTES=60        # how often the regime is re-evaluated

# ── Robinhood (options trading) ───────────────────────────────────────────────
# Create an account at robinhood.com and enable options trading in the app.
# If you have 2FA enabled, provide the Base32 TOTP secret from Authenticator
# setup and install pyotp:  pip install pyotp
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=
ROBINHOOD_MFA_SECRET=       # optional; Base32 TOTP secret for 2FA

# Options Strategy
# Buys deep in-the-money options (|delta| >= OPTIONS_MIN_DELTA, default 0.70)
# when Fear & Greed signals an extreme reading.
# Call entries: F&G < OPTIONS_BUY_CALL_FEAR_THRESHOLD (extreme fear = buy the dip)
# Put  entries: F&G > OPTIONS_BUY_PUT_FEAR_THRESHOLD  (extreme greed = hedge)
OPTIONS_ENABLED=false
OPTIONS_SYMBOLS=AAPL,SPY,QQQ,TSLA,NVDA
OPTIONS_MIN_DTE=21              # minimum days to expiration
OPTIONS_MAX_DTE=60              # maximum days to expiration
OPTIONS_MIN_DELTA=0.70          # only buy contracts with |delta| >= this value
OPTIONS_MAX_POSITIONS=5
OPTIONS_TAKE_PROFIT_PCT=0.50    # close when premium gains +50%
OPTIONS_STOP_LOSS_PCT=0.50      # close when premium loses -50%
OPTIONS_CLOSE_AT_DTE=7          # close position when DTE drops below this
OPTIONS_BUY_CALL_FEAR_THRESHOLD=30
OPTIONS_BUY_PUT_FEAR_THRESHOLD=70
OPTIONS_CAPITAL_ALLOCATION_PCT=0.10   # fraction of total equity for options
OPTIONS_CHECK_INTERVAL_MINUTES=60
OPTIONS_MIN_VOLUME=100          # skip contracts with volume below this
OPTIONS_MIN_OPEN_INTEREST=500   # skip contracts with OI below this
OPTIONS_MAX_IV=1.50             # skip contracts with implied volatility above 150%
